 #include "libANGLE/renderer/null/FramebufferNULL.h"
 
 namespace rx
 {
+namespace
+{
+constexpr EGLint kDefaultRefreshRateHz = 60;
+constexpr EGLint kMinimumRefreshRateHz = 1;
+constexpr EGLint kMaximumRefreshRateHz = 240;
+
+EGLint GetRefreshRateHz()
+{
+#if defined(ANGLE_PLATFORM_ANDROID)
+    char propertyValue[PROP_VALUE_MAX] = {};
+    if (__system_property_get("debug.angle.null_refresh_hz", propertyValue) > 0)
+    {
+        char *end       = nullptr;
+        const long rate = ANGLE_UNSAFE_TODO(std::strtol(propertyValue, &end, 10));
+        if (end != propertyValue && *end == '\0' && rate >= kMinimumRefreshRateHz &&
+            rate <= kMaximumRefreshRateHz)
+        {
+            return static_cast<EGLint>(rate);
+        }
+    }
+#endif
+    return kDefaultRefreshRateHz;
+}
+}  // namespace
 
-SurfaceNULL::SurfaceNULL(const egl::SurfaceState &surfaceState) : SurfaceImpl(surfaceState) {}
+SurfaceNULL::SurfaceNULL(const egl::SurfaceState &surfaceState) : SurfaceNULL(surfaceState, nullptr)
+{}
 
-SurfaceNULL::~SurfaceNULL() {}
+SurfaceNULL::SurfaceNULL(const egl::SurfaceState &surfaceState,
+                         EGLNativeWindowType nativeWindow)
+    : SurfaceImpl(surfaceState),
+      mNativeWindow(nativeWindow),
+      mWidth(surfaceState.attributes.getAsInt(EGL_WIDTH, 100)),
+      mHeight(surfaceState.attributes.getAsInt(EGL_HEIGHT, 100)),
+      mSwapInterval(surfaceState.swapInterval),
+      mRefreshRateHz(GetRefreshRateHz()),
+      mSwapCount(0),
+      mNextSwapDeadline()
+{
+#if defined(ANGLE_PLATFORM_ANDROID)
+    if (mNativeWindow != nullptr)
+    {
+        ANativeWindow_acquire(mNativeWindow);
+    }
+#endif
+}
+
+SurfaceNULL::~SurfaceNULL()
+{
+    releaseNativeWindow();
+}
 
 egl::Error SurfaceNULL::initialize(const egl::Display *display)
 {
+#if defined(ANGLE_PLATFORM_ANDROID)
+    if (mNativeWindow != nullptr)
+    {
+        mWidth  = ANativeWindow_getWidth(mNativeWindow);
+        mHeight = ANativeWindow_getHeight(mNativeWindow);
+        if (mWidth <= 0 || mHeight <= 0)
+        {
+            return egl::Error(EGL_BAD_NATIVE_WINDOW, "NULL backend received an invalid window size.");
+        }
+        return postInitialBlackFrame();
+    }
+#endif
     return egl::NoError();
 }
 
+void SurfaceNULL::destroy(const egl::Display *display)
+{
+    releaseNativeWindow();
+}
+
+void SurfaceNULL::releaseNativeWindow()
+{
+#if defined(ANGLE_PLATFORM_ANDROID)
+    if (mNativeWindow != nullptr)
+    {
+        ANativeWindow_release(mNativeWindow);
+        mNativeWindow = nullptr;
+    }
+#endif
+}
+
+egl::Error SurfaceNULL::postInitialBlackFrame()
+{
+#if defined(ANGLE_PLATFORM_ANDROID)
+    if (ANativeWindow_setBuffersGeometry(mNativeWindow, mWidth, mHeight,
+                                         WINDOW_FORMAT_RGBA_8888) != 0)
+    {
+        return egl::Error(EGL_BAD_NATIVE_WINDOW,
+                          "NULL backend failed to configure the Android window buffer.");
+    }
+
+    ANativeWindow_Buffer buffer = {};
+    ARect dirtyRect             = {0, 0, mWidth, mHeight};
+    if (ANativeWindow_lock(mNativeWindow, &buffer, &dirtyRect) != 0)
+    {
+        return egl::Error(EGL_BAD_NATIVE_WINDOW,
+                          "NULL backend failed to lock the Android window buffer.");
+    }
+
+    constexpr size_t kBytesPerPixel = 4;
+    ANGLE_UNSAFE_TODO(std::memset(
+        buffer.bits, 0,
+        static_cast<size_t>(buffer.height) * static_cast<size_t>(buffer.stride) * kBytesPerPixel));
+
+    if (ANativeWindow_unlockAndPost(mNativeWindow) != 0)
+    {
+        return egl::Error(EGL_BAD_NATIVE_WINDOW,
+                          "NULL backend failed to post the Android window buffer.");
+    }
+#endif
+    return egl::NoError();
+}
+
+void SurfaceNULL::paceSwap()
+{
+    if (mSwapInterval <= 0 || mRefreshRateHz <= 0)
+    {
+        return;
+    }
+
+    const auto period = std::chrono::nanoseconds(
+        1000000000LL * static_cast<int64_t>(mSwapInterval) / mRefreshRateHz);
+    const auto now = std::chrono::steady_clock::now();
+    if (mNextSwapDeadline.time_since_epoch().count() == 0 || now > mNextSwapDeadline + period * 4)
+    {
+        mNextSwapDeadline = now + period;
+    }
+    else
+    {
+        mNextSwapDeadline += period;
+    }
+    std::this_thread::sleep_until(mNextSwapDeadline);
+}
+
 egl::Error SurfaceNULL::swap(const gl::Context *context, SurfaceSwapFeedback *feedback)
 {
+    paceSwap();
+    ++mSwapCount;
     return egl::NoError();
 }
 
